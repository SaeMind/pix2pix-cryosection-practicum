{
  "name": "nb_fold3_he",
  "fold": 3,
  "target": "HE",
  "splits": "splits/nextbrain_fold3.json",
  "all_splits_glob": "splits/nextbrain_fold{k}.json",
  "metadata": "outputs/nextbrain_metadata/nextbrain_all_cases.csv",
