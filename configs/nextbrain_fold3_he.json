  "lr": 0.0002, "beta1": 0.5, "beta2": 0.999, "batch_size": 1,
  "epochs_const": 50, "epochs_decay": 50,
  "seed": 1234, "image_size": 256,
  "timing_iters": 200, "warmup_iters": 10,
